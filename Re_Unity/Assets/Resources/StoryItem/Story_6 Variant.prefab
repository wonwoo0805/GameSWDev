    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[0]'
      value: "\uC6B0\uB9AC\uB294 \uADF8\uC800 \uC2E4\uD5D8\uCCB4\uC600\uC744 \uBFD0\uC774\uC57C.
        \n\uCC98\uC74C\uBD80\uD130 \uC720\uB2C8\uC628\uC758 \uD504\uB85C\uC81D\uD2B8\uB294
        \uB9E1\uB294\uAC8C \uC544\uB2C8\uC5C8\uB294\uB370.."
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[1]'
      value: "\uC6B0\uB9AC\uAC00 \uD560 \uC218 \uC788\uB294 \uAC83\uC740 \uC544\uBB34\uAC83\uB3C4
        \uC5C6\uC5C8\uC5B4.\n\uC774\uC81C\uB294 \uB0A8\uC740 \uD0C8\uCD9C\uB85C\uB9C8\uC800
        \uB9C9\uD600\uC788\uB2E4.\uC2DD\uB7C9\uB3C4 \uC5C6\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[2]'
      value: "\"\uC720\uB2C8\uC628... \uADF8\uB4E4\uC774 \uBAA8\uB4E0 \uAC83\uC744
        \uACC4\uD68D\uD55C \uAC83\uC778\uAC00?\n\uB354 \uC54C\uC544\uBCF4\uAE30 \uC704\uD574\uC11C\uB294
        \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uC57C\uACA0\uC5B4.\""
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[3]'
