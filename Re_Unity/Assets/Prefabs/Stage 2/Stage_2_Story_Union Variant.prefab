    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: storyText
      value: "\uC720\uB2C8\uC628 \uBC14\uC774\uC624... \uADF8\uB4E4\uC774 \uBAA8\uB4E0
        \uAC78 \uC54C\uACE0 \uC788\uC5C8\uB2E4. \n\uC6B0\uB9AC\uB294 \uADF8\uC800
        \uC2E4\uD5D8\uCCB4\uC600\uC744 \uBFD0\uC774\uC57C.\n\uC6B0\uB9AC\uAC00 \uD560
        \uC218 \uC788\uB294 \uAC83\uC740 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC5B4.\n\uC774\uC81C\uB294
        \uB0A8\uC740 \uD0C8\uCD9C\uB85C \uB9C8\uC800 \uB9C9\uD600\uC788\uB2E4.\n\uC2DD\uB7C9\uB3C4
        \uC5C6\uC5B4. \uB204\uAD70\uAC00 \uC6B0\uB9AC\uB97C \uAD6C\uC6D0\uD574\uC904
        \uC218 \uC788\uC744\uAE4C?"
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: monologue.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[0]'
      value: "\uAE00\uC528\uB294 \uCC28\uBD84\uD558\uC9C0\uB9CC \uC808\uB9DD\uC774
        \uB290\uAEF4\uC9C4\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[1]'
      value: "\uC720\uB2C8\uC628 \uAC70\uB300 \uAE30\uC5C5\uC758 \uC5F0\uD569 \uADF8\uB4E4\uC774
        \n\uBAA8\uB4E0 \uAC83\uC744 \uACC4\uD68D\uD55C \uAC83\uC778\uAC00?"
      objectReference: {fileID: 0}
    - target: {fileID: 8742056674378394164, guid: 7c1864eeb9ce5c6439c2b122c45cd1d3, type: 3}
      propertyPath: 'monologue.Array.data[2]'
      value: "\uB354 \uC54C\uC544\uBCF4\uAE30 \uC704\uD574\uC11C\uB294 \uC544\uB798\uB85C
        \uB0B4\uB824\uAC00\uC57C\uACA0\uC5B4"
