    m_Modifications:
    - target: {fileID: 2639824815209702508, guid: 4ad45b58153ab624db7b5149f44b7669, type: 3}
      propertyPath: storyText
      value: "2112 10 21\n\uC2E4\uD5D8\uCCB4 1\uC774 \uC0AC\uB9DD\uD588\uB2E4.\n\uB2E4\uB978
        \uC2E4\uD5D8\uCCB4\uB4E4\uC758 \uC0C1\uD0DC\uB3C4 \uC870\uAE08\uC529 \uC774\uC0C1\uD558\uB2E4.\n\n2112
        11 22\n\uC2E4\uD5D8\uCCB4 1\uC774 \uC0B4\uC544\uB0AC\uB2E4.\n\uC6B0\uB9AC\uC758
        \uC5F0\uAD6C\uAC00 \uC798 \uC9C4\uD589\uB418\uACE0 \uC788\uB294 \uAC83\uC77C\uAE4C?\n\n2112
        12 23\n\uC2E4\uD5D8\uCCB4 1\uC774 \uC774\uC0C1\uD558\uB2E4. \uC810\uC810
        \uD3EC\uC545\uD574\uC9C0\uACE0 \uC788\uB2E4.\n\uD504\uB85C\uC81D\uD2B8 \uB9AC\uBC14\uC774\uBE0C\uC758
        \uC131\uACF5\uC774 \uAC70\uC758 \uB208\uC55E\uC778\uB370...\n\n2113 2 2\n\uC2E4\uD5D8\uC740
        \uC2E4\uD328\uB2E4. \uBC15\uC0AC\uAC00 \uC6B0\uB9AC\uB97C \uC18D\uC600\uB2E4.
        \n\uC774 \uC2E4\uD5D8\uC740 \uC808\uB300 \uC548\uC804\uD558\uC9C0 \uC54A\uC544.
        \uC9C0\uAE08\uC774\uB77C\uB3C4 \uBA48\uCDB0\uC57C \uD574.\n\uC6B0\uB9AC\uB294
        \uC798\uBABB\uB41C \uAE38\uC744 \uC654\uB2E4. \n\uC81C\uBC1C \uB204\uAD70\uAC00
        \uC774\uACF3\uC744 \uAD6C\uC6D0\uD574\uC8FC\uAE38..."
      objectReference: {fileID: 0}
